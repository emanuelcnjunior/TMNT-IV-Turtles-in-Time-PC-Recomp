# Linux x86-64 from Windows, using the verified v1.0.14 portable toolchains.
# TMNT_CROSS_ROOT contains windows/bin and linux/{sysroot,deps,lib/clang/22}.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT TMNT_CROSS_ROOT)
    get_filename_component(TMNT_CROSS_ROOT "${CMAKE_CURRENT_LIST_DIR}/../build-linux-tools" ABSOLUTE)
endif()
file(TO_CMAKE_PATH "${TMNT_CROSS_ROOT}" TMNT_CROSS_ROOT)
set(_bin "${TMNT_CROSS_ROOT}/windows/bin")
set(_linux "${TMNT_CROSS_ROOT}/linux")
set(CMAKE_C_COMPILER "${_bin}/clang-22.exe")
set(CMAKE_CXX_COMPILER "${_bin}/clang-22.exe")
set(CMAKE_CXX_COMPILER_ARG1 "--driver-mode=g++")
set(CMAKE_C_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_AR "${_bin}/llvm-ar.exe")
set(CMAKE_RANLIB "${_bin}/llvm-ranlib.exe")
set(CMAKE_STRIP "${_bin}/llvm-strip.exe")
set(CMAKE_SYSROOT "${_linux}/sysroot")
set(_flags "--no-default-config -resource-dir=${_linux}/lib/clang/22 --rtlib=compiler-rt --unwindlib=libgcc")
set(CMAKE_C_FLAGS_INIT "${_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_flags} -isystem ${CMAKE_SYSROOT}/usr/include/c++/12 -isystem ${CMAKE_SYSROOT}/usr/include/x86_64-linux-gnu/c++/12")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -L${CMAKE_SYSROOT}/usr/lib/gcc/x86_64-linux-gnu/12")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${_linux}/deps")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(SDL3_DIR "${_linux}/deps/lib/cmake/SDL3" CACHE PATH "Linux SDL3")
set(OpenGL_GL_PREFERENCE LEGACY)
set(CMAKE_BUILD_RPATH "$ORIGIN")
